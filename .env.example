# Local development defaults. Copy to .env and adjust; .env is gitignored.
#
# These point at the in-memory fake from `make fake-opnsense`. `make run` uses
# hack/local/config.yaml when CONFIG_PATH is unset. To run against a
# real appliance, copy hack/local/config.yaml somewhere else, set base_url to
# the appliance API, and point CONFIG_PATH at the copy.

CONFIG_PATH=hack/local/config.yaml

# The fake accepts any credentials, or none. A real appliance needs real ones,
# and they belong in a Secret rather than in a values file.
OPNSENSE_API_KEY=local-key
OPNSENSE_API_SECRET=local-secret
