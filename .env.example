# Local development defaults. Copy to .env and adjust; .env is gitignored.
#
# These point at the in-memory fake from `make fake-opnsense`. To run against a
# real appliance, copy hack/local/dns-provider.yaml somewhere else, set base_url
# to the appliance API, and point DNS_PROVIDER_PATH at the copy.

DOMAIN_MAP_PATH=hack/local/domain-map.yaml
DNS_PROVIDER_PATH=hack/local/dns-provider.yaml

# The fake accepts any credentials, or none. A real appliance needs real ones,
# and they belong in a Secret rather than in a values file.
OPNSENSE_API_KEY=local-key
OPNSENSE_API_SECRET=local-secret
