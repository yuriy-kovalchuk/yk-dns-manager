# Path to the single configuration file (domain map + DNS providers).
CONFIG_PATH=examples/config.yaml

# Credentials are not read from this file at all: the app reads them from the
# Kubernetes Secret named in each provider instance's `secret` config field.
# Create that Secret in your cluster yourself — each provider declares the
# keys it expects (e.g. OPNsense: API_KEY / API_SECRET), so the format is up
# to the provider you use:
#
#   kubectl create secret generic opnsense-creds -n <namespace> \
#     --from-literal=API_KEY=... --from-literal=API_SECRET=...
