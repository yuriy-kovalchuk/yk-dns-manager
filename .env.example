# Optional local overrides; `make run` works without a .env. Copy to .env and
# adjust; .env is gitignored.
#
# Without CONFIG_PATH, `make run` uses hack/local/config.yaml, which selects the
# in-memory provider. To run against a real appliance, copy
# examples/config.yaml, set base_url to the appliance API, and point
# CONFIG_PATH at the copy.

# CONFIG_PATH=.developer/config.yaml

# Real appliance credentials, referenced from the config as ${OPNSENSE_API_KEY}
# and ${OPNSENSE_API_SECRET}. `make kind-secret` puts them in a Secret.
# OPNSENSE_API_KEY=
# OPNSENSE_API_SECRET=
