# syntax=docker/dockerfile:1

# Local development image for the in-memory OPNsense fake. Never published: it is
# built by `make kind-fake-install` and loaded into kind so the controller has a
# DNS backend to talk to inside the cluster.

FROM golang:1.27.2-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -trimpath -o /fake-opnsense ./hack/fake-opnsense

FROM gcr.io/distroless/static@sha256:963fa6c544fe5ce420f1f54fb88b6fb01479f054c8056d0f74cc2c6000df5240

COPY --from=builder /fake-opnsense /fake-opnsense

USER 65532:65532

EXPOSE 8053

ENTRYPOINT ["/fake-opnsense"]
